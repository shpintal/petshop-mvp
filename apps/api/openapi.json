                      "dog",
                      "cat",
                      "bird",
                      "rodent"
                    ]
                  },
                  "breed": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "birthDate": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "sterilised": {
                    "default": false,
                    "type": "boolean"
                  },
                  "weightKg": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 120
                  },
                  "allergies": {
                    "default": [],
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 40
                    }
                  },
                  "sensitiveDigestion": {
                    "default": false,
                    "type": "boolean"
