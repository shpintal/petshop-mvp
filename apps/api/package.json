{
  "name": "@petshop/api",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "db:reset": "node dist/db/tools/reset.js",
    "db:generate": "node dist/db/tools/generate-migration.js",
    "openapi": "node dist/tools/export-openapi.js",
    "test": "node --test --experimental-test-isolation=none \"dist/test/*.test.js\"",
    "typecheck": "tsc -p . --noEmit"
  }
